# Deployer key (never commit a real .env)
PRIVATE_KEY=

# RPC endpoints. Testnet public RPC: https://rpc.testnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_RPC_URL=

# Index components: comma-separated Chainlink-compatible feed addresses and weights (bps, sum 10000).
# Leave empty to deploy mock feeds (testnet/demo only) and keep them fresh with scripts/push-prices.js.
FEEDS=
WEIGHTS=
INDEX_NAME=dibVarse AI Index
INDEX_SYMBOL=AIX
INDEX_DESCRIPTION=Five AI leaders. One index.

# ETH sent to the vault reserves at deploy (backs users' gains)
RESERVE_ETH=0.1

# Vault parameters
FEE_BPS=30
MAX_PAYOUT_BPS=30000
MIN_PRINCIPAL=0.001
WALLET_PRINCIPAL_LIMIT=0.2
# Seconds before a price counts as stale (use market-hours-aware values for real stock feeds)
MAX_PRICE_AGE=86400
EMERGENCY_DELAY=259200
