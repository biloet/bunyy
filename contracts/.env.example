# Deployer key (never commit a real .env)
PRIVATE_KEY=

# RPC endpoints, e.g. https://robinhood-testnet.g.alchemy.com/v2/<API_KEY>
ROBINHOOD_TESTNET_RPC_URL=
ROBINHOOD_RPC_URL=

# Uniswap V2-compatible DEX on Robinhood Chain used for graduation.
# Leave empty to deploy without one and call setDex() later.
DEX_FACTORY=
WETH=

# Optional: defaults to the deployer
FEE_RECIPIENT=

# Curve parameters (whole-token / ETH units)
TOTAL_SUPPLY=1000000000
SALE_SUPPLY=800000000
VIRTUAL_ETH=1
VIRTUAL_TOKEN=1073000000
TRADE_FEE_BPS=100
CREATION_FEE=0
MIGRATION_FEE=0.05
