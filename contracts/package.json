{
  "name": "dibvarse-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Bonding-curve token launchpad contracts for Robinhood Chain",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
