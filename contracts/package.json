    "@openzeppelin/contracts": "^5.1.0",
    "chai": "^4.5.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "hardhat": "^2.22.17",
    "solc": "0.8.24"
  }
}
