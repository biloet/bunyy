# Which chain the app talks to: testnet | mainnet | local
VITE_CHAIN=testnet

# RPC URL, e.g. https://robinhood-testnet.g.alchemy.com/v2/<API_KEY>
# (local defaults to http://127.0.0.1:8545)
VITE_RPC_URL=

# Block explorer base URL (testnet default: https://explorer.testnet.chain.robinhood.com)
VITE_EXPLORER_URL=

# Printed by `npm run deploy:*` in ../contracts
VITE_LAUNCHPAD_ADDRESS=
VITE_LAUNCHPAD_FROM_BLOCK=0
