# Which chain the app talks to: testnet | mainnet | local
VITE_CHAIN=testnet

# RPC URL. Optional on testnet: defaults to the official public (rate-limited)
# https://rpc.testnet.chain.robinhood.com. For production use a provider such as
# https://robinhood-testnet.g.alchemy.com/v2/<API_KEY>. Local defaults to http://127.0.0.1:8545.
VITE_RPC_URL=

# Block explorer base URL (testnet default: https://explorer.testnet.chain.robinhood.com)
VITE_EXPLORER_URL=

# Printed by `npm run deploy:*` in ../contracts
VITE_VAULT_ADDRESS=
VITE_VAULT_FROM_BLOCK=0
